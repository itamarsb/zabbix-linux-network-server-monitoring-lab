# Docker Compose project
COMPOSE_PROJECT_NAME=zabbix-noc-lab

# Container images
POSTGRES_IMAGE=postgres:16.15-alpine3.24
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:ubuntu-7.0.30
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:ubuntu-7.0.30
MONITORED_WEB_IMAGE=nginx:1.28.0-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.30

# PostgreSQL
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# Published ports
ZABBIX_WEB_HTTP_PORT=8080
ZABBIX_SERVER_PORT=10051
MAILPIT_WEB_HTTP_PORT=8025
SNMP_AGENT_PORT=161

# SNMP target
SNMP_COMMUNITY=replace_with_a_private_snmp_community
SNMP_ALLOWED_NETWORK=172.16.0.0/12
SNMP_SYSTEM_NAME=zabbix-lab-snmp-target
SNMP_SYSTEM_LOCATION=Docker-based NOC Operations Lab
SNMP_SYSTEM_CONTACT=NOC Lab Administrator

# Regional configuration
PHP_TZ=America/Sao_Paulo
